# OS / Editor
.DS_Store
.idea/
.vscode/
*.swp

# Go
services/**/bin/
services/**/tmp/
services/**/vendor/
*.test
*.out

# Python
__pycache__/
*.pyc
.venv/
venv/
.env
services/**/.pytest_cache/
services/**/.mypy_cache/

# Node / React
node_modules/
dist/
services/**/npm-debug.log*
services/**/yarn-error.log*

# Data / Models / Checkpoints
data/raw/*
data/processed/*
data/binance/*.csv
# bulk kline archives. reproduce.sh re-downloads these from data.binance.vision,
# so tracking them adds ~147 MB to every clone for no reproducibility benefit.
data/binance_klines/
services/rl-py/nano_rl/checkpoints/*
services/agent-py/*.pkl
!data/raw/.keep
!data/processed/.keep
!data/sample/*.csv

# Docker
*.log

# Misc
ws-test.html

# ---------------------------------------------------------------- agent-rl
# virtualenv
services/agent-rl/.venv/

# api cache and built corpus. both are regenerated by scripts/build_corpus.py
# from public endpoints, so they are reproducible rather than precious. the
# raw kalshi tape in particular runs to ~6.9 MB per market, which is why the
# ingest resamples and discards it rather than caching it wholesale.
data/kalshi/
data/corpus/

# training artifacts
services/agent-rl/runs/
services/agent-rl/checkpoints/
*.pt

# pytest
.pytest_cache/

# reports are regenerated by reproduce.sh, but the figures ARE the deliverable
# for docs/REPORT.md, so they are tracked. results.json likewise.

# compiled go binaries. 22 MB of windows executables were tracked here, which
# was 60% of the repository. they rebuild with `go build`.
*.exe
services/engine-go/engine
services/feed-sim/replay

# latex build artifacts. main.pdf is tracked; it is the deliverable.
docs/paper/*.aux
docs/paper/*.bbl
docs/paper/*.blg
docs/paper/*.log
docs/paper/*.out
# rendered page images used to eyeball the pdf. the tracked figures live
# in docs/paper/figures/, which this does not match.
docs/paper/*.png

# the TMLR submission build is generated from docs/paper/main.tex by
# make_tmlr.py. the PDF is tracked as the submission artifact; the derived
# LaTeX is not, so it cannot drift out of sync with its source.
docs/paper/tmlr/main.tex
docs/paper/tmlr/figures/
docs/paper/tmlr/references.bib
